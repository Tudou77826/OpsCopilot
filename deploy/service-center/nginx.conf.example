# Replace host and certificate paths with the intranet deployment values.
server {
    listen 443 ssl;
    server_name ops.example.internal;
    ssl_certificate /etc/nginx/certs/ops.crt;
    ssl_certificate_key /etc/nginx/certs/ops.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Necessary requests must not become identifiable usage records.
    access_log off;
    # nginx error messages can contain client addresses and request URLs.
    error_log /dev/null crit;
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:9080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1800s;
    }
}
