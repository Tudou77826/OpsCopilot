{
  "llm": {
    "APIKey": "your-api-key-here",
    "BaseURL": "https://api.example.com/v1",
    "FastModel": "gemini-2.5-flash",
    "ComplexModel": "glm46"
  },
  "log": {
    "dir": "logs"
  },
  "docs": {
    "dir": ""
  },
  "cli": {
    "exec_timeout_sec": 120
  },
